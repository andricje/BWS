<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="h4 mb-3">Nova lozinka</h2>
        <p class="text-muted">Nalog: <strong><%= email %></strong></p>
        <form method="post" action="/reset-password/<%= token %>">
          <div class="mb-3">
            <label class="form-label" for="password">Nova lozinka</label>
            <input class="form-control" type="password" id="password" name="password" minlength="6" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="confirmPassword">Potvrda lozinke</label>
            <input class="form-control" type="password" id="confirmPassword" name="confirmPassword" required>
          </div>
          <button class="btn btn-primary w-100" type="submit">Sačuvaj lozinku</button>
        </form>
      </div>
    </div>
    <div class="card mt-3 border-info">
      <div class="card-header bg-info-subtle small fw-semibold">Token info (demo)</div>
      <div class="card-body small font-monospace text-break">
        <div>Host pri kreiranju: <%= hostUsed %></div>
        <div class="mt-2">Link: <%= resetLink %></div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
