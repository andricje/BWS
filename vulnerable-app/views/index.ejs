<%- include('partials/header') %>

<div class="row align-items-center g-4">
  <div class="col-lg-7">
    <h1 class="display-5 fw-bold">SecureBank</h1>
    <p class="lead text-muted">
      Demo bankarska aplikacija sa namerno ranjivom obradom <code>Host</code> HTTP zaglavlja.
    </p>
    <div class="d-flex flex-wrap gap-2">
      <% if (!currentUser) { %>
        <a href="/login" class="btn btn-primary btn-lg">Prijava</a>
        <a href="/register" class="btn btn-outline-primary btn-lg">Registracija</a>
      <% } else { %>
        <a href="/dashboard" class="btn btn-primary btn-lg">Dashboard</a>
      <% } %>
      <a href="/forgot-password" class="btn btn-outline-secondary btn-lg">Zaboravljena lozinka</a>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-warning">
      <div class="card-header bg-warning-subtle fw-semibold">Debug – trenutni base URL</div>
      <div class="card-body">
        <p class="mb-2 small">Aplikacija gradi apsolutne URL-ove iz Host zaglavlja:</p>
        <code class="d-block text-break"><%= baseUrl %></code>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
